# Primary and secondary hostnames. Caddy serves both (plus their www
# variants) from one site block and gets a certificate for each, so both
# need an A record pointing at this server before it can issue TLS.
# The canonical host for SEO is set separately via SITE_URL in frontend.env.
DOMAIN=reportajgo.uz
DOMAIN_ALT=reportagego.com
ACME_EMAIL=admin@reportajgo.uz
BACKEND_POSTGRES_PASSWORD=change-me-backend-db-password
FRONTEND_POSTGRES_PASSWORD=change-me-frontend-db-password
