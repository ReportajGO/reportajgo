# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database (Postgres) ──────────────────────────────────────────────────────
# Host ports are 5433/6380 (see docker-compose.yml) to avoid clashing with other
# local Postgres/Redis instances. Inside Docker the containers still use 5432/6379.
DATABASE_URL=postgresql://reportajgo:reportajgo@localhost:5433/reportajgo?schema=public

# ─── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Research: Google Gemini ──────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# ─── Image generation ─────────────────────────────────────────────────────────
# "higgsfield": use the Higgsfield Soul/DoP API (needs HIGGSFIELD_CREDENTIALS).
# "gemini": generate images with the Gemini image model, stored locally and
# served under /media. Higgsfield falls back to Gemini if credentials are absent.
IMAGE_PROVIDER=higgsfield
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Directory generated media is written to, and the base URL it's served from.
MEDIA_DIR=media
# Defaults to http://localhost:DASHBOARD_PORT. Set a public URL (tunnel/CDN)
# when publishing generated media to social platforms.
PUBLIC_BASE_URL=
# local writes generated media to MEDIA_DIR and serves it from /media.
# s3 uploads generated media to AWS S3 and returns public S3/CDN URLs.
MEDIA_STORAGE_DRIVER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom S3-compatible endpoint. Leave blank for AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Optional CDN/public base. Defaults to the bucket URL when blank.
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_KEY_PREFIX=media

# ─── Media generation: Higgsfield (optional, for video / IMAGE_PROVIDER=higgsfield) ─
# Create API credentials at https://cloud.higgsfield.ai (dashboard > API).
# Format: "KEY_ID:KEY_SECRET" (a server process needs a key — the MCP login
# in your chat client is NOT usable by this long-running agent).
HIGGSFIELD_CREDENTIALS=
# ─── Presenter voice: ElevenLabs (for `npm run anchor:video`) ─────────────────
# The presenter's cloned voice lives in YOUR ElevenLabs account and is private
# to it, so this key is the only way to reach it. Create one at
# https://elevenlabs.io (Profile > API Keys).
ELEVENLABS_API_KEY=
# The cloned Uzbek presenter voice.
ELEVENLABS_VOICE_ID=xr8iiOGfCd6vvCgIh6EV
# eleven_v3 covers Uzbek; eleven_multilingual_v2 / turbo do not.
ELEVENLABS_MODEL_ID=eleven_v3

# Fallback provider if Higgsfield is unavailable: "none" | "fal" | "replicate"
MEDIA_FALLBACK_PROVIDER=none
FAL_API_KEY=
REPLICATE_API_TOKEN=

# ─── Content config ───────────────────────────────────────────────────────────
# Comma-separated. Primary language posts are generated in this/these.
# NOTE: with the Global Media Network strategy each MARKET supplies its own
# publication language (see ACTIVE_MARKETS below), so this list now only affects
# the legacy single-language flows.
CONTENT_LANGUAGES=uz,ru,en
# DEPRECATED — superseded by the seven fixed content verticals in
# src/domain/verticals.ts (economy 25%, innovation 15%, science 15%, startup 15%,
# youth/women 15%, facts 8%, history 7%). Kept only so existing .env files parse.
RESEARCH_TOPICS=World news,Breaking international news,Global technology and business
# Reputable global outlets to prioritize during research (comma-separated).
RESEARCH_SOURCES=CNN,BBC,Reuters,Associated Press,Al Jazeera,The Guardian,Bloomberg
# Platforms to generate drafts for (comma-separated).
# Options: TELEGRAM,INSTAGRAM,FACEBOOK,YOUTUBE,WEBSITE
ENABLED_PLATFORMS=TELEGRAM

# ─── Global Media Network strategy ────────────────────────────────────────────
# Rollout phase, which determines the active market set:
#   1 = pilot     (6 markets)  Japan, South Korea, China, Malaysia, Türkiye, UAE
#   2 = expansion (13 markets) + Germany, France, UK, Russia, Saudi, US, Brazil
#   3 = full      (21 markets) + Taiwan, Sweden, Austria, Kuwait, Qatar, Oman,
#                               Spain, Canada
ROLLOUT_PHASE=1
# Explicit market allowlist (comma-separated codes). Overrides ROLLOUT_PHASE.
# Use this to run ONE market while testing so a single pipeline run doesn't fan
# out across every pilot market at once. Valid codes:
#   JP KR MY CN TW TR DE FR UK SE AT RU ES AE KW QA OM SA US CA BR
ACTIVE_MARKETS=
# How many verticals each research cycle covers per market. The cycle picks
# whichever verticals sit furthest below their target share.
VERTICALS_PER_RUN=2
# Production formats the media pipeline can currently deliver. The strategy is
# video-first (60% short + explainer video), but the video engine must be wired
# before those formats can be produced — add them here once it is:
#   SHORT_VIDEO,EXPLAINER_VIDEO,TEXT_POST,CAROUSEL,MINI_REPORTAGE,INTERVIEW,ARTICLE,INFOGRAPHIC
AVAILABLE_FORMATS=TEXT_POST,CAROUSEL,ARTICLE,INFOGRAPHIC

# ─── Publishers ───────────────────────────────────────────────────────────────
# Telegram (start here — no app review needed). Create a bot via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# Meta (Instagram + Facebook) — fill once app review is approved
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_FB_PAGE_ID=

# X / Twitter (paid API tier required to post)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ─── Dashboard / approval API ─────────────────────────────────────────────────
DASHBOARD_PORT=3010
# Network interface the dashboard binds to. Loopback (127.0.0.1) keeps the
# control API off the network. Only set 0.0.0.0 behind an authenticating proxy.
DASHBOARD_BIND=127.0.0.1
# Comma-separated **numeric Telegram user IDs** allowed to control the bot
# (approve/reject/publish/settings). NOT emails — the bot compares against the
# sender's numeric id. Find yours by messaging @userinfobot on Telegram.
# Example: APPROVERS=123456789,987654321
APPROVERS=
# HTTP Basic login for the web dashboard / API. REQUIRED in production (the app
# refuses to start an open dashboard when NODE_ENV=production). In dev it may be
# blank (dashboard runs open, loopback-only, with a startup warning).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Telegram approval bot — sends each ready post for Approve/Reject review.
# Create a bot via @BotFather. Leave blank to disable the approval bot.
TELEGRAM_APPROVAL_BOT_TOKEN=

# Telegram Mini App / approval admin. In production set WEBAPP_PUBLIC_URL to the
# public HTTPS admin URL so the bot does not need a cloudflared quick tunnel.
WEBAPP_ENABLED=true
WEBAPP_PUBLIC_URL=
WEBAPP_PATH=/ru/admin
WEBAPP_MENU_TEXT=Admin Panel

# ─── Scheduling ───────────────────────────────────────────────────────────────
# How often the research job runs (cron). Default: every 2 hours.
RESEARCH_CRON=0 */2 * * *
# Preferred recency window in hours. This is a soft preference, NOT a hard cut:
# the network publishes constructive and evergreen material (research results,
# working technologies, founder stories, durable facts), so a strong item is not
# discarded for being older than the window. 168 = one week.
RESEARCH_MAX_AGE_HOURS=168
# Max top-ranked news items drafted per run (caps approval-queue volume/cost).
# Each item fans out to (markets x platforms) drafts, so raise this carefully.
MAX_ITEMS_PER_RUN=8
# Auto-delete news items older than this many hours. Published website articles
# live in the website's own DB and are unaffected.
#
# Keep this at 30 days or more. Two things depend on the history:
#   1. Dedupe — items are de-duplicated by content hash. If retention is shorter
#      than RESEARCH_MAX_AGE_HOURS, a purged evergreen story gets re-discovered
#      and published twice.
#   2. Mix balancing — the vertical and format balancers measure the last 30 days
#      to find which shares are under-served. Purge sooner and the editorial mix
#      drifts back to whatever research happened to return.
NEWS_RETENTION_HOURS=720

# ─── Editorial gate + strong filter ───────────────────────────────────────────
# All values below are live-tunable from the Telegram control panel (🎯 Filter)
# and the dashboard API (PUT /settings) — no redeploy needed. Env sets defaults.
# Minimum editorial score (0..1) to be drafted. Higher = stricter (was 0.45).
MIN_SCORE=0.6
# Minimum relevance (0..1) to the item's vertical and target market.
MIN_RELEVANCE=0.5
# Minimum constructive value (0..1): does the story centre on a solution,
# opportunity, measurable progress or genuinely useful knowledge? This is the
# core editorial gate of the network — problem-centred material scores low here.
MIN_CONSTRUCTIVENESS=0.6
# Minimum verifiability (0..1): can every claim be traced to a named, credible
# source? Backs the "source discipline 100%" KPI.
MIN_VERIFIABILITY=0.6
# Lowest priority level that still gets drafted: LOW | NORMAL | HIGH.
# BREAKING is no longer assigned — the network does not publish breaking news,
# so setting it here would filter out everything.
MIN_PRIORITY=NORMAL
# Optional source/keyword gates (comma-separated, case-insensitive substring).
# Allowlists are only enforced when non-empty. Leave blank for no restriction.
SOURCE_ALLOWLIST=
SOURCE_BLOCKLIST=
KEYWORD_ALLOWLIST=
KEYWORD_BLOCKLIST=

# Timezone for scheduling posts
TZ=Asia/Tashkent
